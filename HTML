<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgroTur Paraná</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <div class="container">
            <h1>AgroTur Paraná</h1>
            <p>Descubra as riquezas do turismo rural paranaense</p>
        </div>
    </header>

    <nav>
        <ul>
            <li><a href="#sobre">Sobre</a></li>
            <li><a href="#destinos">Destinos</a></li>
            <li><a href="#eventos">Eventos</a></li>
            <li><a href="#contato">Contato</a></li>
        </ul>
    </nav>

    <section class="hero">
        <div class="hero-content">
            <h2>Vivencie o Campo Paranaense</h2>
            <p>Fazendas, gastronomia típica, trilhas e experiências autênticas.</p>
            <button id="btnSaibaMais">Saiba Mais</button>
        </div>
    </section>

    <section id="sobre" class="container">
        <h2>Sobre o Turismo Rural</h2>
        <p>
            O Paraná oferece diversas experiências ligadas ao agronegócio e ao turismo rural.
            Os visitantes podem conhecer fazendas, plantações, produção de alimentos,
            além de desfrutar da cultura e gastronomia local.
        </p>
    </section>

    <section id="destinos" class="container">
        <h2>Destinos em Destaque</h2>

        <div class="cards">
            <div class="card">
                <h3>Campos Gerais</h3>
                <p>Paisagens naturais, fazendas históricas e turismo de aventura.</p>
            </div>

            <div class="card">
                <h3>Norte Pioneiro</h3>
                <p>Rota do café, cultura agrícola e gastronomia regional.</p>
            </div>

            <div class="card">
                <h3>Oeste do Paraná</h3>
                <p>Produção agropecuária moderna e turismo tecnológico.</p>
            </div>
        </div>
    </section>

    <section id="eventos" class="container">
        <h2>Eventos do Agro</h2>
        <ul>
            <li>Feiras Agropecuárias</li>
            <li>Festivais Gastronômicos</li>
            <li>Exposições Rurais</li>
            <li>Dias de Campo</li>
        </ul>
    </section>

    <section id="contato" class="container contato">
        <h2>Contato</h2>

        <form>
            <input type="text" placeholder="Seu nome" required>
            <input type="email" placeholder="Seu e-mail" required>
            <textarea placeholder="Sua mensagem"></textarea>
            <button type="submit">Enviar</button>
        </form>
    </section>

    <footer>
        <p>&copy; 2026 AgroTur Paraná - Turismo Rural</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
